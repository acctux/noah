{
  "archinstall": {
    "user_name": "nick",
    "hostname": "yulia",
    "password": "6623",
    "kernel": [
      "linux"
    ],
    "kb_layout": "us",
    "sys_lang": "en_US",
    "sys_enc": "UTF-8",
    "timezone": "US/Eastern"
  },
  "groups": [
    "adm",
    "games",
    "realtime",
    "storage",
    "video"
  ],
  "services": {
    "system": {
      "enable": [
        "ananicy-cpp",
        "bluetooth",
        "tlp",
        "iwd",
        "ly@tty1",
        "named",
        "firewalld",
        "swayosd-libinput-backend",
        "systemd-networkd",
        "systemd-oomd",
        "systemd-timesyncd",
        "btrfs-scrub@-.timer",
        "btrfs-scrub@home.timer",
        "fstrim.timer",
        "logrotate.timer",
        "man-db.timer",
        "paccache.timer",
        "reflector.timer",
        "loggy",
        "wireguard-list"
      ],
      "disable": [
        "getty@tty1",
        "systemd-networkd-wait-online"
      ]
    },
    "user": [
      {
        "target": "default.target.wants",
        "services": [
          "pipewire-pulse.service"
        ],
        "source_dir": "/usr/lib/systemd/user"
      },
      {
        "target": "sockets.target.wants",
        "services": [
          "pipewire-pulse.socket"
        ],
        "source_dir": "/usr/lib/systemd/user"
      }
    ]
  },
  "mkinitcpio": {
    "hooks": [
      "base",
      "systemd",
      "autodetect",
      "microcode",
      "modconf",
      "kms",
      "sd-vconsole",
      "block",
      "filesystems",
      "fsck"
    ]
  },
  "filesystem": {
    "script_pwd_to_copy": [
      "etc",
      "usr"
    ]
  },
  "reflector": {
    "options": [
      "--country US",
      "--protocol https",
      "--latest 10",
      "--sort rate",
      "--number 3"
    ]
  },
  "usb": {
    "fs_type": "exfat",
    "min_size": "20G",
    "key_dir": "keys",
    "ssh_key": "id_ed25519",
    "gpg_key": "my_sec_gpg.asc",
    "pass_manager_pass": "pass.txt",
    "sec_conf_file": "pass.py",
    "wireguard_dir": "wireguard",
    "copy_files": [
      "id_ed25519",
      "my_sec_gpg.asc",
      "pass.txt"
    ]
  },
  "git": {
    "user": "acctux",
    "base_dir": "Lit",
    "repos": [
      {
        "target_dir": "Lit",
        "repos": [
          "Docs",
          "noah"
        ]
      },
      {
        "target_dir": "",
        "repos": [
          "Polka"
        ]
      }
    ],
    "dots_dir": "Polka",
    "enc_dir": "Desktop/Encrypted"
  },
  "icons": {
    "dirs": [
      [
        "Desktop/Games",
        "folder-games.svg"
      ],
      [
        "Lit",
        "folder-github.svg"
      ],
      [
        "Lit/Noah",
        "folder-root.svg"
      ],
      [
        "Lit/Docs",
        "folder-bookmark.svg"
      ],
      [
        "Polka",
        "folder-html.svg"
      ],
      [
        "Desktop/Encrypted",
        "folder-locked.svg"
      ]
    ]
  },
  "symlinks": {
    "dirs_to_link": [
      "config/systemd/user",
      "config/nvim",
      "local/bin"
    ],
    "individual": [
      [
        "Lit/Docs/fonts",
        ".local/share/fonts"
      ],
      [
        "Lit/Docs/task",
        ".config/task"
      ],
      [
        "Lit/Docs/zsh",
        ".config/zsh"
      ]
    ]
  },
  "hide_apps": [
    "avahi-discover.desktop",
    "bssh.desktop",
    "btop.desktop",
    "bvnc.desktop",
    "com.github.FontManager.FontViewer.desktop",
    "jshell-java-openjdk.desktop",
    "jconsole-java-openjdk.desktop",
    "khal.desktop",
    "libreoffice-base.desktop",
    "libreoffice-draw.desktop",
    "libreoffice-math.desktop",
    "nvtop.desktop",
    "octopi-cachecleaner.desktop",
    "octopi-notifier.desktop",
    "octopi-repoeditor.desktop",
    "org.gnome.Nautilus.desktop",
    "org.gnome.baobab.desktop",
    "org.kde.kdeconnect.nonplasma.desktop",
    "qt5ct.desktop",
    "qt6ct.desktop",
    "qv4l2.desktop",
    "qvidcap.desktop",
    "taskwarrior-tui.desktop",
    "uuctl.desktop",
    "xgps.desktop",
    "xgpsspeed.desktop"
  ]
}
